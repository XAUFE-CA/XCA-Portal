# 运行环境：development、test 或 production。
# production 要求 HTTPS 的 PUBLIC_ORIGIN、数据库 sslmode=verify-full、真实 SMTP 凭据，并拒绝回环、未指定及 Mailpit 邮件主机。
APP_ENV=development

# HTTP 监听地址，格式为 主机:端口。示例只监听本机回环地址，部署入口负责对外暴露。
API_LISTEN_ADDR=127.0.0.1:8080

# 数据库：POSTGRES_PORT 是 Compose 映射到宿主机的端口，默认 5432；被占用时改为其他空闲端口，并同步修改 DATABASE_URL。
# POSTGRES_PASSWORD 仅 Compose 创建本地 PostgreSQL 时使用，Go 进程不读取，必须与 DATABASE_URL 中的密码一致。
# DATABASE_URL 是 PostgreSQL 连接 URL，包含用户名、密码、主机和数据库名；开发使用 sslmode=disable，production 必须使用 sslmode=verify-full。
# sslmode 是 URL 的查询参数，不是独立环境变量。本地示例：postgres://xca_dev:<密码>@127.0.0.1:5432/xca_dev?sslmode=disable
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
DATABASE_URL=

# 邮件：MAIL_TRANSPORT 取 mailpit 或 smtp，production 只接受 smtp。
# SMTP_HOST 开发指向本地 Mailpit，production 拒绝回环、未指定与 Mailpit 地址。
# SMTP_PORT 同时作为 Mailpit 的宿主机端口，容器内固定 1025；production 使用邮件服务商端口。
# SMTP_TLS_MODE 取 none、starttls 或 implicit，production 拒绝 none，且不会回退为明文。
# SMTP_USERNAME 与 SMTP_PASSWORD 必须同时填写或同时留空，production 要求填写。
# MAIL_FROM 必须是可解析的发件地址，开发使用测试身份，不使用真实个人邮箱。
MAIL_TRANSPORT=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_TLS_MODE=none
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=xca@example.invalid

# 密钥：验证码与限流使用两个独立的 HMAC 密钥，均为至少 32 字节随机数据经 Base64 编码后的值，两者不得相同。
# OTP_HMAC_KEY_VERSION 是当前验证码密钥版本，正整数，默认 1。
# 轮换期间在 OTP_PREVIOUS_HMAC_KEYS 以逗号分隔的 版本:Base64密钥 保留旧版本；版本与密钥均不得重复，也不得与当前版本或限流密钥相同。
OTP_HMAC_KEY=
OTP_HMAC_KEY_VERSION=1
OTP_PREVIOUS_HMAC_KEYS=
RATE_LIMIT_HMAC_KEY=

# 会话、来源与代理：SESSION_TTL 为 Go 时长格式，按创建时间绝对过期，不因使用延长。
# PUBLIC_ORIGIN 必须与浏览器访问的协议、主机和端口完全一致，production 要求 HTTPS，不能带路径。
# TRUSTED_PROXY_CIDRS 是逗号分隔的直接代理网段，可为空；production 拒绝 0.0.0.0/0 等覆盖全部地址的网段。
SESSION_TTL=24h
PUBLIC_ORIGIN=http://127.0.0.1:4100
TRUSTED_PROXY_CIDRS=

# HTTP 时限与正文：下列时限均为 Go 时长格式。API_READ_TIMEOUT、API_WRITE_TIMEOUT、API_IDLE_TIMEOUT 上限 5m，API_SHUTDOWN_TIMEOUT、DEPENDENCY_TIMEOUT 上限 1m。
# DEPENDENCY_TIMEOUT 用于就绪检查，必须小于 API_WRITE_TIMEOUT。
# API_MAX_BODY_BYTES 为请求正文字节上限，有效值 1 到 10485760（10 MiB），未设置时默认 1048576（1 MiB）。
API_READ_TIMEOUT=15s
API_WRITE_TIMEOUT=15s
API_IDLE_TIMEOUT=60s
API_SHUTDOWN_TIMEOUT=10s
DEPENDENCY_TIMEOUT=2s
API_MAX_BODY_BYTES=1048576
