{
  "name": "XCA-Portal",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "format": "biome check --write --linter-enabled=false . && prettier --write \"**/*.{md,yml,yaml}\"",
    "format:check": "biome check --linter-enabled=false . && prettier --check \"**/*.{md,yml,yaml}\"",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@nuxt/content": "^3.16.1",
    "nuxt": "4.6.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "prettier": "3.9.10",
    "prettier-plugin-markdown-compact-tables": "1.0.0"
  },
  "packageManager": "bun@1.4.4"
}
