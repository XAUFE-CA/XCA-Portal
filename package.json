{
  "name": "xca-portal",
  "type": "module",
  "private": true,
  "scripts": {
    "format": "biome check --write --linter-enabled=false . && prettier --write \"**/*.{md,yml,yaml}\"",
    "format:check": "biome check --linter-enabled=false . && prettier --check \"**/*.{md,yml,yaml}\"",
    "ui:sync": "bun scripts/deps/sync-neoverse-ui.ts",
    "texts:stamp": "bun scripts/build/stamp-terminal-texts.ts",
    "build": "nuxt build",
    "typecheck": "nuxt typecheck",
    "test": "bun scripts/tests/test-plan.ts run unit,module",
    "test:e2e": "bun run build && bun scripts/tests/test-plan.ts run system",
    "test:scene": "bun run build && bun scripts/tests/test-plan.ts run system --scene",
    "test:visual": "bun run build && bun scripts/tests/test-plan.ts run system --snapshot",
    "check:terminal": "bun scripts/gates/check-terminal-boundary.ts",
    "check:tests": "bun scripts/gates/check-test-registry.ts",
    "check": "bun scripts/gates/run-gates.ts",
    "dev": "bun run ui:sync && nuxt dev --strictPort",
    "generate": "nuxt generate",
    "preview": "nuxt preview --port 4100 --strictPort",
    "postinstall": "nuxt prepare",
    "lint": "biome lint .",
    "check:budgets": "bun scripts/gates/check-budgets.ts",
    "check:docs": "bun scripts/gates/check-docs.ts",
    "check:architecture": "bun scripts/gates/check-architecture.ts",
    "check:fast": "bun scripts/gates/run-gates.ts --fast"
  },
  "dependencies": {
    "@neoverse-ui/glass-runtime": "file:../Neoverse-UI/packages/glass-runtime",
    "@neoverse-ui/motion": "file:../Neoverse-UI/packages/motion",
    "@neoverse-ui/overlay-runtime": "file:../Neoverse-UI/packages/overlay-runtime",
    "@neoverse-ui/tailwind": "file:../Neoverse-UI/packages/tailwind",
    "@neoverse-ui/tokens": "file:../Neoverse-UI/packages/tokens",
    "@neoverse-ui/vue": "file:../Neoverse-UI/packages/vue",
    "@nuxt/content": "^3.16.2",
    "better-sqlite3": "13.0.3",
    "morphicons": "2.0.2",
    "nuxt": "4.6.3",
    "three": "0.187.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "overrides": {
    "@neoverse-ui/glass-runtime": "file:../Neoverse-UI/packages/glass-runtime",
    "@neoverse-ui/motion": "file:../Neoverse-UI/packages/motion",
    "@neoverse-ui/overlay-runtime": "file:../Neoverse-UI/packages/overlay-runtime",
    "@neoverse-ui/tailwind": "file:../Neoverse-UI/packages/tailwind",
    "@neoverse-ui/tokens": "file:../Neoverse-UI/packages/tokens",
    "@neoverse-ui/vue": "file:../Neoverse-UI/packages/vue"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/three": "0.187.0",
    "prettier": "3.9.10",
    "prettier-plugin-markdown-compact-tables": "1.0.0",
    "typescript": "6.0.3",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "bun@1.4.4"
}
